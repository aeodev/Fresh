[Unit]
Description=FreshQA Kooya Freshchat test service on port 54321
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kooya/repos/freshqa-v2
Environment=PATH=/home/kooya-agent/.nvm/versions/node/v24.18.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=WRANGLER_SEND_METRICS=false
ExecStart=/home/kooya-agent/.nvm/versions/node/v24.18.1/bin/node node_modules/wrangler/bin/wrangler.js dev --local --ip 10.66.0.2 --port 54321 --inspector-ip 127.0.0.1 --inspector-port 15432 --local-upstream freshqa-kooya.test.kooyaai.com --upstream-protocol https --test-scheduled --show-interactive-dev-session=false
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
